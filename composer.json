{
  "name": "evolvex/laravel-agent-fabric",
  "description": "Production AI agent operating system for Laravel: governed agents, model routing, knowledge, tools, approvals, memory, verification, durable runs, evaluations, and observability.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "ai",
    "agents",
    "rag",
    "llm",
    "automation",
    "governance"
  ],
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "illuminate/cache": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/events": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "laravel/ai": "^0.11",
    "illuminate/filesystem": "^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "nunomaduro/larastan": "^3.10",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Evolvex\\AgentFabric\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Evolvex\\AgentFabric\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Evolvex\\AgentFabric\\AgentFabricServiceProvider"
      ],
      "aliases": {
        "AgentFabric": "Evolvex\\AgentFabric\\Facades\\AgentFabric"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
